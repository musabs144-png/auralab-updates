@echo off

chcp 65001 >nul
title AuraLab Pro 12.5.4 - Setup
cd /d "%~dp0"
echo.
echo   ============================================================
echo      AURA LAB PRO  12.5.4   -   Start Setup
echo   ============================================================
echo.
powershell -NoProfile -ExecutionPolicy Bypass -File "%~dp0install_cert.ps1"
set CERT=%ERRORLEVEL%
echo.
echo   Press any key to start the installer ...
pause >nul
if exist "%~dp0AuraLab_Setup.exe" (
    start "" "%~dp0AuraLab_Setup.exe"
) else (
    echo   ERROR: AuraLab_Setup.exe is missing next to this file.
    pause
)
exit /b 0
